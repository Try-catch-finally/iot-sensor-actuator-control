# MQTT 连接配置模板
# 复制本文件为 .env 并填写实际值（.env 已被 .gitignore 排除，不会进入仓库）
# 注意：VITE_ 前缀变量在构建时注入，纯前端部署下凭据仍可能被浏览器侧看到，
#       生产环境建议由服务端代理转发 MQTT 或对网关做鉴权/IP 白名单。

VITE_MQTT_SERVER=your-mqtt-server-host
VITE_MQTT_PORT=8083
VITE_MQTT_SUBSCRIBE_TOPIC=usr/sensor
VITE_MQTT_PUBLISH_TOPIC=usr/actuator
VITE_MQTT_USERNAME=your_username
VITE_MQTT_PASSWORD=your_password
VITE_MQTT_USE_SSL=false